# Copy this file to .env and fill in real values.
# With `docker-compose up -d`, DATABASE_URL and REDIS_URL below work as-is.

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgres://rs_auth_ai:rs_auth_ai@localhost:5432/rs_auth_ai
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRATION=604800

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# AI provider (Tongyi Qianwen / DashScope)
AI_TONGYI_API_KEY=
AI_TONGYI_API_ENDPOINT=
